# =============================================================================
# SexS OS — Variáveis de ambiente
# =============================================================================
# Copie este arquivo para .env e ajuste os valores conforme necessário.
# NUNCA versione o arquivo .env (ele está no .gitignore).

# ---- Servidor ----
PORT=3000

# CRÍTICO: defina como "production" em qualquer ambiente que não seja desenvolvimento local.
# Se não estiver "production", o sistema devolve tokens de recuperação de senha
# na resposta HTTP (modo demonstração) e exibe credenciais de demo na tela de login.
NODE_ENV=development

# ---- Banco de dados ----
# Caminho do arquivo SQLite. Deixe vazio para usar o padrão (data/sexsos.db).
# Em testes, use ":memory:" para banco em memória.
# SEXSOS_DB_PATH=

# ---- IA (opcional — o sistema funciona 100% offline sem estas variáveis) ----
# Configure APENAS UM provedor. Se nenhum estiver configurado, o sistema usa
# o mecanismo offline (regex determinístico) sem nenhuma diferença funcional.

# Anthropic (Claude)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI (GPT)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Google Gemini
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.0-flash

# Ollama (local — sem custo de API)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# ---- Forçar provedor de IA (avançado) ----
# Sobrescreve a detecção automática. Use só se precisar forçar um provedor
# mesmo tendo chaves de outros configuradas.
# AI_PROVIDER=anthropic

# ---- Dados da empresa (para setup-company.js) ----
# Preencha com os dados reais do Certificado MEI/CNPJ antes de rodar
# o script de setup. NUNCA deixe estes dados hardcoded no código.
# COMPANY_LEGAL_NAME=
# COMPANY_TRADE_NAME=
# COMPANY_DOCUMENT_ID=
# COMPANY_OWNER_NAME=
# COMPANY_OWNER_DOCUMENT_ID=
# COMPANY_OPENING_DATE=
# COMPANY_REGISTRATION_STATUS=
# COMPANY_TAX_REGIME=
# COMPANY_MAIN_CNAE=
# COMPANY_MAIN_CNAE_DESCRIPTION=
# COMPANY_ADDRESS_ZIP=
# COMPANY_ADDRESS_STREET=
# COMPANY_ADDRESS_NUMBER=
# COMPANY_ADDRESS_DISTRICT=
# COMPANY_ADDRESS_CITY=
# COMPANY_ADDRESS_STATE=
